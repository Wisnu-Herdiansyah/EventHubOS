{
  "name": "eventhub-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:bootstrap": "node packages/db/src/cli/bootstrap.ts",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "db:check": "node packages/db/src/cli/check-migrations.ts",
    "openapi:generate": "node apps/api/src/cli/generate-openapi.ts",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:check && pnpm test",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
