# Copy to .env for local development. Never commit real values.
# Runtime environment: local | ci | staging | production
EVENTHUB_ENV=local
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Proxies whose X-Forwarded-For the API believes: false, or a list of IPs/CIDRs (e.g. the admin
# app's address). `true` is refused in staging/production.
TRUST_PROXY=false

# Least-privilege runtime role (NOBYPASSRLS, not table owner). Set by `pnpm db:bootstrap`.
DATABASE_APP_URL=postgres://eventhub_app:<set-locally>@localhost:5432/eventhub
# Outbox relay role (reads/updates outbox only).
DATABASE_WORKER_URL=postgres://eventhub_worker:<set-locally>@localhost:5432/eventhub
# Schema owner used only by the migration job, never by runtime workloads.
DATABASE_MIGRATOR_URL=postgres://eventhub_migrator:<set-locally>@localhost:5432/eventhub

# Sessions and login throttling (API)
SESSION_TTL_HOURS=12
# Idle timeout (ADR-0018), 15-1440 minutes.
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
INVITATION_TTL_HOURS=168

# Worker broker (ADR-0009): the PostgreSQL outbox, delivered to in-process consumers.
EVENT_PUBLISHER=postgres_outbox
# OUTBOX_HEALTH_INTERVAL_MS=60000
# OUTBOX_LAG_WARN_SECONDS=300
# Email: local adapters below are refused in staging/production; use resend there.
EMAIL_SENDER=local_file
EMAIL_LOCAL_DIR=.local/mail
# Production email (ADR-0008): EMAIL_SENDER=resend plus the values below.
# RESEND_API_KEY=<from secret manager>
# EMAIL_FROM=EventHub OS <no-reply@your-verified-domain>
# At least 32 random characters; derives retry-stable verification tokens.
EMAIL_TOKEN_SECRET=<generate-locally: openssl rand -hex 32>
APP_BASE_URL=http://localhost:3001
EMAIL_VERIFICATION_TTL_HOURS=24
# Password reset links (ADR-0015), 10-240 minutes.
PASSWORD_RESET_TTL_MINUTES=60

# Admin web app (apps/admin). Server-side only; never exposed to the browser.
ADMIN_API_URL=http://127.0.0.1:3000
# ADMIN_ORIGIN=https://admin.your-domain       # public origin; https enables upgrade-insecure-requests
# Proxies (load balancer, CDN) in front of the admin app; 0 = forward no client IP to the API.
ADMIN_TRUSTED_PROXY_HOPS=0

# Integration tests: superuser URL of a disposable local/CI PostgreSQL instance.
TEST_DATABASE_ADMIN_URL=postgres://postgres:<set-locally>@localhost:5432/postgres
